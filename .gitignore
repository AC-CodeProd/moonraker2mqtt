# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
# Allowlisting gitignore template for GO projects prevents us
# from adding various unwanted local files, such as generated
# files, developer configurations or IDE-specific files etc.
#
# Recommended: Go.AllowList.gitignore
# Ignore everything
*
# But not these files...
!/.gitignore
!*.gitkeep
!*.go
!.air.toml
!package.json
!pnpm-lock.yaml
!go.mod
!go.sum
!Makefile
!README.md
!README_FR.md
!LICENSE.txt
!config.yaml
# ...even if they are in subdirectories
!*/

!.github/workflows/release-please.yml
!.github/workflows/auto-pull-requests.yml
!.release-please-config.json
!.release-please-manifest.json
!VERSION
!Dockerfile
!.dockerignore
tmp
# Local host/firmware build artifacts (may embed credentials)
/build/
/builds/
# Firmware safety sources and tooling (keep build artifacts ignored).
!/platform/esp32s3/settings_hw.c
!/platform/esp32s3/radio_state.c
!/targets/esp32s3-settings.ld
!/targets/esp32s3-settings.json
!/targets/settings-vectors.S
!/tools/settings_image.py
!/tools/settings_target.py
!/tools/test_settings_target.py
!/tools/audit_settings.py
!/docs/ESP32S3_SETUP.md
!/docs/ESP32S3_MEMORY.md
!/websocket/wire/lowmem/LICENSE
